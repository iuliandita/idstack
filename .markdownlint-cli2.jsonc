{
  "config": {
    "default": true,
    "code-block-style": {
      "style": "fenced"
    },
    "code-fence-style": {
      "style": "backtick"
    },
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-inline-html": {
      "allowed_elements": ["h1", "img"]
    },
    // Off because existing documents fail them.
    "line-length": false,
    "no-bare-urls": false,
    "first-line-heading": false,
    "blanks-around-lists": false,
    "fenced-code-language": false,
    "blanks-around-fences": false
  },
  "gitignore": true,
  "globs": [
    ".github/**/*.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "INSTALL.md",
    "README.md",
    "SECURITY.md",
    "agents/*.md",
    "docs/**/*.md",
    "skills/**/*.md",
    "src/**/*.md"
  ],
  "ignores": [
    "**/node_modules/**"
  ]
}
