{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "timezone": "Etc/UTC",
  "schedule": [
    "* 6 * * 1"
  ],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in workflow files, each under a `# renovate: datasource=... depName=...` comment",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\s+[A-Za-z_]+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/tools/harness/**"
      ],
      "groupName": "harness",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        ".github/tools/markdownlint/**"
      ],
      "groupName": "markdownlint",
      "semanticCommitType": "deps",
      "semanticCommitScope": "ci"
    }
  ]
}
