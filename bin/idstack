def run_quiet(cmd: list[str], timeout: int = 20) -> tuple[int, str]:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


def skill_dirs() -> list[Path]:
    dirs = [
        HOME / ".claude/skills",
        Path(os.environ.get("AGENTS_SKILLS_DIR", HOME / ".agents/skills")),
        HOME / ".config/opencode/skills",
        HOME / ".codex/skills",
    ]
    dirs += list((HOME / ".claude/plugins/cache").glob("*/*/*/skills"))
    return [d for d in dirs if d.is_dir()]


def cmd_doctor(a) -> int:
    checks: list[dict] = []

    def add(name, status, detail=""):
        checks.append({"name": name, "status": status, "detail": detail})

    agents_skills = Path(os.environ.get("AGENTS_SKILLS_DIR", HOME / ".agents/skills"))
    harnesses = [h for h in ("claude", "codex", "opencode") if shutil.which(h)]
    add("harnesses", "ok" if harnesses else "fail", ", ".join(harnesses) or "none of claude, codex, opencode on PATH")
    if "claude" in harnesses:
        rc, out = run_quiet(["claude", "plugin", "list", "--json"], 60)
        try:
            ids = {p["id"]: p.get("enabled") for p in json.loads(out)} if rc == 0 else {}
        except ValueError:
            ids = {}
        for pid in ("pstack@cursor-plugins", "idstack@idstack"):
            add(f"claude {pid}", "ok" if ids.get(pid) else "fail", "enabled" if ids.get(pid) else "missing or disabled")
    if "codex" in harnesses or "opencode" in harnesses:
        ok = (agents_skills / "poteto-mode/SKILL.md").is_file()
        add("pstack for codex/opencode", "ok" if ok else "fail", str(agents_skills / "poteto-mode"))
    if "codex" in harnesses:
        rc, out = run_quiet(["codex", "plugin", "list", "--json"], 60)
        ok = rc == 0 and '"idstack@idstack"' in out
        add("codex idstack@idstack", "ok" if ok else "fail", "installed" if ok else "missing")
        agents_dir = Path(os.environ.get("CODEX_HOME", HOME / ".codex")) / "agents"
        have = [n for n in ("id-agent", "plan-reader", "change-verifier") if (agents_dir / f"{n}.toml").is_file()]
        add("codex idstack agents", "ok" if len(have) == 3 else "warn", f"{len(have)}/3 in {agents_dir}")
    if "opencode" in harnesses:
        oc = Path(os.environ.get("OPENCODE_SKILLS_DIR", opencode_dir() / "skills"))
        add("opencode id-mode skill", "ok" if (oc / "id-mode/SKILL.md").exists() else "fail", str(oc))
        cfg = opencode_dir() / "opencode.json"
        try:
            doc = json.loads(cfg.read_text()) if cfg.is_file() else {}
        except ValueError:
            doc = None
        if doc is None:
            add("opencode skill permissions", "warn", f"{cfg} is not plain JSON; not checked")
        else:
            manifest = agents_skills / ".pstack-install.json"
            pstack = json.loads(manifest.read_text()).get("skills", []) if manifest.is_file() else ["poteto-mode"]
            ours = sorted(p.parent.name for p in (ROOT / "skills").glob("*/SKILL.md"))
            blocked = [n for n in ours + pstack if opencode_skill_effect(doc, n) != "allow"]
            add(
                "opencode skill permissions",
                "fail" if {"id-mode", "poteto-mode"} & set(blocked) else "warn" if blocked else "ok",
                "idstack and pstack skills allowed"
                if not blocked
                else f"not allowed in {cfg} (add allow rules): " + ", ".join(blocked),
            )
        agents_dir = Path(os.environ.get("OPENCODE_AGENTS_DIR", opencode_dir() / "agents"))
        have = [n for n in ("id-agent", "plan-reader", "change-verifier") if (agents_dir / f"{n}.md").is_file()]
        add("opencode idstack agents", "ok" if len(have) == 3 else "warn", f"{len(have)}/3 in {agents_dir}")
    found = {p.name for d in skill_dirs() for p in d.iterdir() if (p / "SKILL.md").exists()}
    missing = [s for s in DOMAIN_SKILLS if s not in found]
    add(
        "domain skills",
        "ok" if not missing else "warn",
        "all found" if not missing else "missing (playbooks use fallbacks): " + ", ".join(missing),
    )
    absent = [c for c in INFRA_CLIS if not shutil.which(c)]
    add(
        "infra CLIs",
        "ok" if not absent else "warn",
        "all on PATH" if not absent else "not on PATH: " + ", ".join(absent),
    )
    add(
        "jev key",
        "ok" if os.environ.get("TYPESAFE_API_KEY") else "warn",
        "TYPESAFE_API_KEY set" if os.environ.get("TYPESAFE_API_KEY") else "not set; Jev decision points are skipped",
    )
    models = ROOT / "scripts/pstack_models.py"
    if models.is_file():
        rc, out = run_quiet([sys.executable, "-I", str(models), "--check"], 120)
        add("pstack model files", "ok" if rc == 0 else "warn", " ".join(out.split())[:200])
    g = guard_config()
    if g["mode"] == "off":
        add("guard", "ok", "mode off (opt-in; enable with `idstack guard enable`)")
    else:
        # Claude Code and Codex run the plugin's own hook; without the plugin, Codex and OpenCode need `guard install`.
        unguarded = [h for h in ("codex", "opencode") if h in harnesses and not guard_installed(h)]
        twice = "codex" in harnesses and guard_in_config("codex") and codex_plugin_hook() is not None
        add(
            "guard",
            "warn" if unguarded or twice else "ok",
            f"mode {g['mode']}"
            + "".join(f"; not installed for {h}: run `idstack guard install --harness {h}`" for h in unguarded)
            + ("; two guard hooks for codex: run `idstack guard install --harness codex` to drop one" if twice else ""),
        )
    if a.live:
        if shutil.which("kubectl"):
            rc, ctx = run_quiet(["kubectl", "config", "current-context"])
            if rc == 0 and ctx.strip():
                rc, out = run_quiet(
                    ["kubectl", "--context", ctx.strip(), "auth", "can-i", "create", "deployments", "--all-namespaces"]
                )
                answer = out.split()[0] if out.split() else ""
                status, detail = {
                    "yes": ("warn", "can create deployments; prefer a read-only context for agents"),
                    "no": ("ok", "read-only for deployments"),
                }.get(answer, ("fail", f"the probe failed (kubectl exit {rc}); write access is unknown"))
                add("kube context write access", status, f"{ctx.strip()}: {detail}")
            else:
                add("kube context write access", "fail", f"no current kube context (kubectl exit {rc}); not probed")
        else:
            add("kube context write access", "skip", "kubectl not on PATH")
    else:
        add("credential write access", "skip", "run with --live to probe the active kube context (read-only check)")
    bad = [c for c in checks if c["status"] == "fail"]
    sym = {"ok": "ok  ", "warn": "warn", "fail": "FAIL", "skip": "skip"}
    text = "\n".join(f"{sym[c['status']]}  {c['name']}: {c['detail']}" for c in checks)
    emit({"checks": checks}, a.json, text, ok=not bad, errors=[f"{c['name']}: {c['detail']}" for c in bad])
    return EXIT_FAIL if bad else EXIT_OK


# --- check ----------------------------------------------------------------------------------


def cmd_check(a) -> int:
    script = ROOT / "scripts/check.py"
    if not script.is_file():
        return fail(a, "scripts/check.py not found: not an idstack checkout; run from a clone", EXIT_USAGE)
    return subprocess.run([sys.executable, str(script), *(["--json"] if a.json else [])]).returncode


# --- build ----------------------------------------------------------------------------------

GENERATED = "Generated by `bin/idstack build` from {src}. Edit the source and rerun the build."
SLASH_ONLY_SKILLS = ("id-mode", "setup")


def parse_agent(path: Path) -> dict:
    m = re.match(r"---\n(.*?)\n---\n(.*)", path.read_text(), re.S)
    if not m:
        raise CliError(f"{path}: no frontmatter; start the file with a --- block", EXIT_FAIL)
    meta = {}
    for line in m.group(1).splitlines():
        k, _, v = line.partition(":")
        meta[k.strip()] = v.strip()
    tools = [t.strip() for t in meta.get("tools", "").split(",") if t.strip()]
    return {"name": meta["name"], "description": meta["description"], "tools": tools, "body": m.group(2).strip() + "\n"}


def build_outputs() -> dict[Path, str]:
    out: dict[Path, str] = {}
    for src in sorted((ROOT / "agents").glob("*.md")):
        ag = parse_agent(src)
        rel = src.relative_to(ROOT).as_posix()
        read_only = bool(ag["tools"]) and not {"Edit", "Write"} & set(ag["tools"])
        body = ag["body"].replace("\\", "\\\\").replace('"""', '\\"\\"\\"')
        if read_only:
            body += "\nYou are read-only: never edit files or run a command that changes state.\n"
        out[ROOT / "harness/codex/agents" / f"{ag['name']}.toml"] = (
            f"# {GENERATED.format(src=rel)}\n"
            f"name = {json.dumps(ag['name'])}\n"
            f"description = {json.dumps(ag['description'])}\n"
            f'developer_instructions = """\n{body}"""\n'
        )
        perm = ["permission:", "  edit: deny", "  bash: allow", "  webfetch: deny"] if read_only else []
        out[ROOT / "harness/opencode/agents" / f"{ag['name']}.md"] = "\n".join(
            [
                "---",
                f"description: {json.dumps(ag['description'])}",
                "mode: subagent",
                *perm,
                "---",
                f"<!-- {GENERATED.format(src=rel)} -->",
                "",
                ag["body"],
            ]
        )
    for skill in sorted((ROOT / "skills").glob("*/SKILL.md")):
        name = skill.parent.name
        implicit = "false" if name in SLASH_ONLY_SKILLS or name.startswith("principle-") else "true"
        out[skill.parent / "agents/openai.yaml"] = (
            f"# {GENERATED.format(src=skill.relative_to(ROOT).as_posix())}\n"
            f"policy:\n  allow_implicit_invocation: {implicit}\n"
        )
    return out


def orphaned_outputs(outputs: dict[Path, str]) -> list[Path]:
    """Generated files whose source is gone (an agent or skill renamed or removed)."""
    found = [
        *(ROOT / "harness/codex/agents").glob("*.toml"),
        *(ROOT / "harness/opencode/agents").glob("*.md"),
        *(ROOT / "skills").glob("*/agents/openai.yaml"),
    ]
    marker = GENERATED.split("{src}")[0]
    return sorted(p for p in found if p not in outputs and marker in p.read_text(errors="replace"))


def cmd_build(a) -> int:
    stale = []
    outputs = build_outputs()
    orphans = orphaned_outputs(outputs)
    for path, content in outputs.items():
        current = path.read_text() if path.exists() else None
        if current == content:
            continue
        stale.append(path.relative_to(ROOT).as_posix())
        if not a.check:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
    removed = [p.relative_to(ROOT).as_posix() for p in orphans]
    if a.check:
        stale += removed
    else:
        for path in orphans:
            path.unlink()
    verb = "stale" if a.check else "wrote"
    emit(
        {"check": a.check, verb: stale, **({} if a.check else {"removed": removed})},
        a.json,
        "\n".join([*(f"{verb}: {p}" for p in stale), *(f"removed: {p}" for p in ([] if a.check else removed))])
        or "generated files are current",
        ok=not (a.check and stale),
        errors=[f"stale generated file: {p}; run `idstack build`" for p in stale] if a.check else None,
    )
    return EXIT_FAIL if a.check and stale else EXIT_OK


