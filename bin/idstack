#!/usr/bin/env python3
"""idstack: helper CLI for the idstack playbooks. Standard library only.

Commands:
  plan-summary PLAN.json   deterministic Terraform/OpenTofu plan summary and grant predicate
  judge BATTERY ITEMS      one Jev decision point; answers only tighten
  doctor                   what is installed, missing, or able to write
  check                    repository checks (scripts/check.py)
  build                    generate Codex and OpenCode agent files and skill policies
  guard                    opt-in pre-tool-use guard for infra commands

Every command accepts --json for machine-readable output.
"""

from __future__ import annotations

import argparse
import fnmatch
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOME = Path.home()
JEV_URL = os.environ.get("IDSTACK_JEV_URL", "https://api.typesafe.ai/v1/systemone")
STATE_DIR = Path(
    os.environ.get("IDSTACK_STATE_DIR") or Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "idstack"
)
CONFIG_DIR = Path(
    os.environ.get("IDSTACK_CONFIG_DIR") or Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "idstack"
)

EXIT_OK, EXIT_FAIL, EXIT_USAGE, EXIT_CALLS, EXIT_NO_KEY = 0, 1, 2, 3, 4


def emit(data, as_json: bool, text: str, ok: bool = True, errors: list[str] | None = None) -> None:
    """Print text, or with --json one object on stdout (ok, errors, the command's keys) and text on stderr."""
    if not as_json:
        print(text)
        return
    if text:
        print(text, file=sys.stderr)
    own = {k: v for k, v in data.items() if k not in ("ok", "errors")}
    print(json.dumps({"ok": ok, "errors": errors or [], **own}, indent=2))


class CliError(Exception):
    def __init__(self, msg: str, code: int):
        super().__init__(msg)
        self.code = code


def usage_error(msg: str) -> CliError:
    return CliError(msg, EXIT_USAGE)


def fail(a, msg: str, code: int) -> int:
    print(f"error: {msg}", file=sys.stderr)
    if getattr(a, "json", False):
        emit({}, True, "", ok=False, errors=[msg])
    return code


# --- plan-summary ---------------------------------------------------------------------------

STATEFUL = re.compile(
    r"(db_|database|_rds|bucket|storage|volume|disk|persistent_volume|snapshot|file_system|"
    r"filestore|efs|fsx|queue|topic|stream|table|dynamodb|redis|elasticache|memorystore|cosmosdb|"
    r"backup|kms_key|secret|_zone$|managed_zone|redshift|neptune|opensearch|elasticsearch|msk|"
    r"ecr_repository|dataset|spanner|key_vault|namespace|stateful_set)",
    re.I,
)
IAM = re.compile(
    r"(iam|_role|role_|policy|binding|_member$|service_account|rbac|permission|grant|access_key|identity)", re.I
)
NOT_IAM = re.compile(
    r"(network_policy|firewall_policy|security_policy|lifecycle_policy|scaling_policy|backup_policy)", re.I
)
NETWORK = re.compile(
    r"(security_group|firewall|network_policy|network_acl|route|subnet|vpc|vnet|cidr|ingress|egress|"
    r"load_balancer|_lb|lb_|nat|peering|gateway|endpoint|_record$|dns|listener|target_group|tunnel|vpn|"
    r"public_ip|_eip|function_url|cloudfront|kubernetes_service(_v1)?$)",
    re.I,
)
EXPOSURE_ATTR = re.compile(
    r"(public|cidr|ingress|egress|source_ranges|allowed_ip|ip_range|firewall|security_group|"
    r"port|allowlist|whitelist|listen|authorized_networks|network|default_action|ip_rules)",
    re.I,
)
IAM_ATTR = re.compile(r"(policy|role|iam|permission|acl|principal|grant|member|binding|service_account)", re.I)
# Nested names only, so no top-level attribute loses the flag it had: every Kubernetes pod spec carries these.
NESTED_NOT_IAM_ATTR = re.compile(r"(pull_policy|restart_policy|dns_policy|message_policy)$", re.I)
NEGATED_PUBLIC = re.compile(r"^(block|restrict|ignore)_public", re.I)
WORLD = re.compile(r"(0\.0\.0\.0/0|::/0)")
ADDRESS_INDEX = re.compile(r'\[(?:"(?:[^"\\]|\\.)*"|[^\]"]*)\]')
ACTIONS = ("create", "update", "import", "delete", "replace", "forget", "create+forget")
DIFF_KEYS = 20


def has_unknown(unknown) -> bool:
    """after_unknown mirrors the value's shape; only a true leaf marks something unknown."""
    if isinstance(unknown, dict):
        return any(has_unknown(v) for v in unknown.values())
    if isinstance(unknown, list):
        return any(has_unknown(v) for v in unknown)
    return unknown is True


def changed_paths(before, after, unknown, path: tuple[str, ...] = ()):
    """Yield (attribute-name path, is unknown, new value) for every leaf a change touches."""
    if unknown is True:
        yield path, True, None
        return
    pair = (before, after)
    if any(isinstance(v, dict) for v in pair) and all(v is None or isinstance(v, dict) for v in pair):
        b, a, u = before or {}, after or {}, unknown if isinstance(unknown, dict) else {}
        for k in sorted({*b, *a, *u}):
            yield from changed_paths(b.get(k), a.get(k), u.get(k), (*path, k))
    elif any(isinstance(v, list) for v in pair) and all(v is None or isinstance(v, list) for v in pair):
        lists = (before or [], after or [], unknown if isinstance(unknown, list) else [])
        for i in range(max(map(len, lists))):
            yield from changed_paths(*(s[i] if i < len(s) else None for s in lists), path)
    elif before != after:
        yield path, False, after
    elif has_unknown(unknown):
        yield path, True, None


def config_expressions(plan: dict, address: str) -> dict | None:
    """The configuration's expressions for a resource, or None when the plan cannot show them."""
    config = plan.get("configuration")
    node = config.get("root_module") if isinstance(config, dict) else None
    parts = ADDRESS_INDEX.sub("", address).split(".")
    while isinstance(node, dict) and len(parts) > 2 and parts[0] == "module":
        calls = node.get("module_calls")
        call = calls.get(parts[1]) if isinstance(calls, dict) else None
        node, parts = call.get("module") if isinstance(call, dict) else None, parts[2:]
    if not isinstance(node, dict) or not isinstance(node.get("resources"), list):
        return None
    for res in node["resources"]:
        if isinstance(res, dict) and res.get("address") == ".".join(parts):
            expressions = res.get("expressions", {})
            return expressions if isinstance(expressions, dict) else None
    return None


def config_sets(node, path: tuple[str, ...], root: bool = True) -> bool:
    """Whether the configuration assigns the attribute at path. Anything it cannot place counts as set."""
    if isinstance(node, list):
        return not node or any(config_sets(n, path, root) for n in node)
    if not isinstance(node, dict) or not path:
        return True
    if not root and (not node or "constant_value" in node or "references" in node):
        return True
    if path[0] in node:
        return config_sets(node[path[0]], path[1:], False)
    # A computed attribute is absent next to its configured siblings. An absent enclosing block is a
    # dynamic block, which the configuration does not list.
    return len(path) > 1


def attr_flags(change: dict, expressions: dict | None = None) -> tuple[bool, bool]:
    """(iam, network) from the attributes a change touches, for resources whose type does not say.

    expressions is the resource's configuration (config_expressions); None counts every unknown attribute.
    """
    before, after = change.get("before") or {}, change.get("after") or {}
    if not isinstance(before, dict) or not isinstance(after, dict):
        return False, False
    names: set[tuple[str, bool]] = set()
    for path, unknown, value in changed_paths(before, after, change.get("after_unknown")):
        if not path:
            continue
        if not before:  # a create sets every attribute; only the ones given a value count
            if unknown:
                if expressions is not None and not config_sets(expressions, path):
                    continue
            elif value is False:
                if not NEGATED_PUBLIC.search(path[-1]):
                    continue
            elif value in (None, "", [], {}):
                continue
        names.update((k, i > 0) for i, k in enumerate(path))
    newly_world = bool(WORLD.search(json.dumps(after))) and not WORLD.search(json.dumps(before))
    network = newly_world or any(EXPOSURE_ATTR.search(k) for k, _ in names)
    iam = any(IAM_ATTR.search(k) and not (nested and NESTED_NOT_IAM_ATTR.search(k)) for k, nested in names)
    return iam, network


def action_kind(actions: list[str]) -> str:
    s = set(actions)
    if s == {"delete", "create"}:
        return "replace"
    if len(actions) == 1:
        return actions[0]
    return "+".join(actions)


def valid_change(change) -> bool:
    if not isinstance(change, dict):
        return False
    actions = change.get("actions")
    if not isinstance(actions, list) or not actions or not all(isinstance(x, str) and x for x in actions):
        return False
    return all(change.get(k) is None or isinstance(change.get(k), dict) for k in ("before", "after", "after_unknown"))


def scope_match(address: str, pattern: str) -> bool:
    """Glob with * and ? only: an address index such as [0] or ["a"] is literal text, not a character class."""
    regex = "".join(".*" if c == "*" else "." if c == "?" else re.escape(c) for c in pattern)
    return bool(re.fullmatch(regex, address, re.S))


def redact(value, mask):
    """Replace the values Terraform marks sensitive (before_sensitive/after_sensitive) with a placeholder."""
    if mask is True:
        return "(sensitive)"
    if isinstance(value, dict) and isinstance(mask, dict):
        return {k: redact(v, mask.get(k)) for k, v in value.items()}
    if isinstance(value, list) and isinstance(mask, list):
        return [redact(v, mask[i] if i < len(mask) else None) for i, v in enumerate(value)]
    return value


def change_diff(change: dict) -> dict:
    """At most DIFF_KEYS changed attributes, IAM and exposure names first, with a marker when any are left out."""
    before = redact(change.get("before") or {}, change.get("before_sensitive"))
    after = redact(change.get("after") or {}, change.get("after_sensitive"))
    if not isinstance(before, dict) or not isinstance(after, dict):
        return {"sensitive": True}
    unknown = change.get("after_unknown")
    unknown = unknown if isinstance(unknown, dict) else {}
    if before and not after and not has_unknown(unknown):
        keys, deleted = list(before), True
    else:
        keys = [k for k in {*before, *after, *unknown} if before.get(k) != after.get(k) or has_unknown(unknown.get(k))]
        deleted = False
    keys.sort(key=lambda k: (not (IAM_ATTR.search(k) or EXPOSURE_ATTR.search(k)), k))
    diff = {}
    for k in keys[:DIFF_KEYS]:
        new = "(known after apply)" if unknown.get(k) is True else after.get(k)
        diff[k] = before[k] if deleted else {"before": before.get(k), "after": new} if before else new
    if deleted:
        diff = {"deleted": diff}
    if len(keys) > DIFF_KEYS:
        diff["(truncated)"] = f"{len(keys) - DIFF_KEYS} more changed attribute(s) not shown"
    text = json.dumps(diff)
    return diff if len(text) <= 4000 else {"truncated": text[:4000]}


def validate_plan(plan) -> None:
    hint = "pass the output of `show -json <planfile>`"
    if not isinstance(plan, dict):
        raise usage_error(f"the plan JSON is not an object; {hint}")
    changes = plan.get("resource_changes", [])
    if not isinstance(changes, list):
        raise usage_error(f"resource_changes is not a list; {hint}")
    for i, rc in enumerate(changes):
        if not isinstance(rc, dict) or not all(isinstance(rc.get(k), str) and rc.get(k) for k in ("address", "type")):
            raise usage_error(f"resource_changes[{i}] is not an object with an address and a type; {hint}")


def summarize_plan(
    plan: dict, scope: list[str], predicate: bool, allow_iam: bool = False, allow_network: bool = False
) -> dict:
    validate_plan(plan)
    counts: dict[str, int] = {}
    changes = []
    for rc in plan.get("resource_changes", []):
        change = rc.get("change")
        # A change the summary cannot read is never a no-op: it is listed and fails the predicate.
        kind = action_kind(change["actions"]) if valid_change(change) else "unrecognized"
        if kind == "unrecognized":
            change = {}
        if change.get("importing") and kind == "no-op":
            kind = "import"
        counts[kind] = counts.get(kind, 0) + 1
        if kind in ("no-op", "read"):
            continue
        rtype, addr = rc["type"], rc["address"]
        attr_iam, attr_network = attr_flags(change, config_expressions(plan, addr))
        changes.append(
            {
                "address": addr,
                "type": rtype,
                "action": kind,
                "importing": bool(change.get("importing")),
                "stateful": bool(STATEFUL.search(rtype)),
                "iam": (bool(IAM.search(rtype)) and not NOT_IAM.search(rtype)) or attr_iam,
                "network": bool(NETWORK.search(rtype)) or attr_network,
                "in_scope": (not scope) or any(scope_match(addr, p) for p in scope),
                "diff": change_diff(change),
            }
        )
    destructive = [c for c in changes if c["action"] == "replace" or {"delete", "forget"} & set(c["action"].split("+"))]
    out_of_scope = [c for c in changes if not c["in_scope"]]
    unknown = [c for c in changes if c["action"] not in ACTIONS]
    result = {
        "counts": counts,
        "changes": changes,
        "destructive": [c["address"] for c in destructive],
        "stateful": [c["address"] for c in changes if c["stateful"]],
        "iam": [c["address"] for c in changes if c["iam"]],
        "network": [c["address"] for c in changes if c["network"]],
        "out_of_scope": [c["address"] for c in out_of_scope],
        "errored": bool(plan.get("errored")),
    }
    if predicate:
        reasons = []
        if not scope:
            reasons.append("no scope; the predicate needs --scope or --scope-file")
        if result["errored"]:
            reasons.append("the plan errored")
        if destructive:
            reasons.append(f"{len(destructive)} delete, replace, or forget action(s)")
        if out_of_scope:
            reasons.append(f"{len(out_of_scope)} change(s) outside the scope")
        if result["iam"] and not allow_iam:
            reasons.append(f"{len(result['iam'])} IAM change(s); name them in the grant and pass --allow-iam")
        if result["network"] and not allow_network:
            reasons.append(
                f"{len(result['network'])} network change(s); name them in the grant and pass --allow-network"
            )
        if unknown:
            reasons.append(f"{len(unknown)} change(s) with an unrecognized action")
        if not plan.get("resource_changes") and not result["errored"]:
            reasons.append("the plan has no resource_changes; is this a `show -json` of a saved plan?")
        result["predicate"] = {"pass": not reasons, "reasons": reasons, "scope": scope}
    return result


def plan_summary_text(r: dict) -> str:
    lines = ["counts: " + (", ".join(f"{k} {v}" for k, v in sorted(r["counts"].items())) or "none")]
    for label, key in (
        ("delete/replace/forget", "destructive"),
        ("stateful", "stateful"),
        ("IAM", "iam"),
        ("network", "network"),
        ("outside scope", "out_of_scope"),
    ):
        lines.append(f"{label}: " + (", ".join(r[key]) if r[key] else "none"))
    if r["errored"]:
        lines.append("plan errored: yes")
    if "predicate" in r:
        p = r["predicate"]
        lines.append("predicate: " + ("PASS" if p["pass"] else "FAIL (" + "; ".join(p["reasons"]) + ")"))
    return "\n".join(lines)


def cmd_plan_summary(a) -> int:
    try:
        plan = json.loads(Path(a.plan).read_text() if a.plan != "-" else sys.stdin.read())
    except (OSError, ValueError, RecursionError) as e:
        return fail(a, f"cannot read plan JSON: {e}; pass a plan file or - for stdin", EXIT_USAGE)
    scope = [p for p in a.scope or [] if p.strip()]
    if a.scope_file:
        try:
            lines = Path(a.scope_file).read_text().splitlines()
        except (OSError, ValueError) as e:
            return fail(a, f"cannot read the scope file: {e}", EXIT_USAGE)
        scope += [ln.strip() for ln in lines if ln.strip() and not ln.strip().startswith("#")]
    if a.predicate and not scope:
        return fail(a, "--predicate needs a scope: pass --scope GLOB or --scope-file FILE", EXIT_USAGE)
    try:
        r = summarize_plan(plan, scope, a.predicate, a.allow_iam, a.allow_network)
    except CliError as e:
        return fail(a, str(e), e.code)
    except RecursionError:
        return fail(a, "the plan JSON is nested too deeply to read", EXIT_USAGE)
    failed = bool(a.predicate) and not r["predicate"]["pass"]
    emit(r, a.json, plan_summary_text(r), ok=not failed, errors=r["predicate"]["reasons"] if failed else None)
    return EXIT_FAIL if failed else EXIT_OK


# --- judge ----------------------------------------------------------------------------------


def load_battery(name: str) -> dict:
    path = ROOT / "src/questions" / f"{name}.json"
    if not re.fullmatch(r"[a-z0-9-]+", name) or not path.is_file():
        known = sorted(p.stem for p in (ROOT / "src/questions").glob("*.json"))
        raise usage_error(f"unknown battery {name!r}; use one of: {', '.join(known)}")
    return json.loads(path.read_text())


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None  # the key stays with the configured origin; a 3xx becomes a call error


JEV_OPENER = urllib.request.build_opener(NoRedirect)
REDACT_VALUE = r"""("(?:[^"\\]|\\.)*"|'[^']*'|[^\s;|&"']+)"""
SECRET_NAME = r"[A-Za-z0-9_.-]*(?:token|secret|passw|key|cred|auth)[A-Za-z0-9_.-]*"
SECRET_PAIR = re.compile(rf"({SECRET_NAME}=)" + REDACT_VALUE, re.I)
SECRET_FLAG = re.compile(rf"((?<![^\s;|&(])--?{SECRET_NAME}\s+)(?!-)" + REDACT_VALUE, re.I)
ENV_ASSIGNMENT = r"[A-Za-z_][A-Za-z0-9_]*=" + REDACT_VALUE.replace("(", "(?:", 1)
ENV_PREFIX = re.compile(
    rf"""(^\s*|[;|&({{]\s*|["']|\b(?:env|export|sudo)\s+)((?:{ENV_ASSIGNMENT}\s+)*{ENV_ASSIGNMENT})"""
)
ENV_VALUE = re.compile(r"([A-Za-z_][A-Za-z0-9_]*=)" + REDACT_VALUE)
URL_USERINFO = re.compile(r"(://)[^/\s@]+@")
AUTH_HEADER = re.compile(r"\b((?:bearer|basic)\s+)[A-Za-z0-9._~+/=-]+", re.I)


def redact_command(cmd: str) -> str:
    """Mask secret-named values, environment assignments, URL credentials, and auth headers.

    Only assignments in front of a command are masked: arguments such as `of=/dev/sdb` are what the
    judge has to read, and hiding them could clear a command the full text would have flagged.
    """

    def mask(m: re.Match) -> str:
        # Whether the value named production still reaches the judge, for the same reason.
        marked = "<redacted:production>" if re.search("prod", m.group(2), re.I) else "<redacted>"
        return m.group(1) + marked

    cmd = SECRET_FLAG.sub(mask, cmd)
    cmd = SECRET_PAIR.sub(mask, cmd)
    cmd = ENV_PREFIX.sub(lambda m: m.group(1) + ENV_VALUE.sub(mask, m.group(2)), cmd)
    cmd = URL_USERINFO.sub(r"\1<redacted>@", cmd)
    return AUTH_HEADER.sub(r"\1<redacted>", cmd)


def jev_url_error() -> str | None:
    parts = urllib.parse.urlsplit(JEV_URL)
    if parts.scheme != "https" or not parts.hostname:
        return "IDSTACK_JEV_URL must be an https URL; nothing was sent"
    return None


def jev_ask(battery: dict, item, key: str, timeout: float = 30) -> tuple[dict | None, str | None, dict]:
    if isinstance(item, dict) and isinstance(item.get("cmd"), str):
        item = {**item, "cmd": redact_command(item["cmd"])}
    body = {"model": battery["model"], "state": {battery["item_key"]: item}, "questions": battery["questions"]}
    if err := jev_url_error():
        return None, err, body
    req = urllib.request.Request(
        JEV_URL,
        data=json.dumps(body).encode(),
        method="POST",
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    try:
        with JEV_OPENER.open(req, timeout=timeout) as resp:
            answer = json.loads(resp.read())
    except (urllib.error.URLError, TimeoutError, ValueError, OSError) as e:
        return None, str(e), body
    if not isinstance(answer, dict):
        return None, "the response is not a JSON object", body
    return answer, None, body


def is_probability(p) -> bool:
    return isinstance(p, (int, float)) and not isinstance(p, bool) and 0 <= p <= 1  # NaN fails the comparison


def jev_outcome(battery: dict, answers: dict | None) -> tuple[str, dict]:
    raw = answers if isinstance(answers, dict) else {}
    probs = {q: raw[q].get("noul") if isinstance(raw.get(q), dict) else None for q in battery["questions"]}
    if answers is None or not probs or any(not is_probability(p) for p in probs.values()):
        return "unsettled", probs
    t, rule = battery["threshold"], battery["rule"]
    strict = (lambda p: p < t) if rule == "any-below" else (lambda p: p > t)
    if any(strict(p) for p in probs.values()):
        return "flag", probs
    if any(p == t for p in probs.values()):
        return "unsettled", probs
    return "clear", probs


def judge_items(battery: dict, items: list, key: str, trace: Path | None) -> list[dict]:
    def one(entry):
        ident, item = entry
        resp, err, body = jev_ask(battery, item, key)
        outcome, probs = jev_outcome(battery, resp.get("answers") if resp else None)
        if trace:
            with trace.open("a") as fh:
                fh.write(
                    json.dumps(
                        {"battery": battery["battery"], "id": ident, "request": body, "response": resp, "error": err}
                    )
                    + "\n"
                )
        return {"id": ident, "outcome": outcome, "answers": probs, "error": err}

    with ThreadPoolExecutor(max_workers=8) as ex:
        results = list(ex.map(one, items))
    if battery["rule"] == "rank":

        def score(r):
            vals = [p for p in r["answers"].values() if is_probability(p)]
            return (r["outcome"] != "unsettled", -(max(vals) if vals else 1.0))

        results.sort(key=score)
    return results


def normalize_items(raw) -> list[tuple[str, object]]:
    if isinstance(raw, dict) and "items" in raw:
        raw = raw["items"]
    if not isinstance(raw, list):
        raise usage_error("items file is not a list; pass a JSON array, or an object with an `items` array")
    out = []
    for i, entry in enumerate(raw):
        if isinstance(entry, dict) and "item" in entry:
            out.append((str(entry.get("id", i)), entry["item"]))
        else:
            out.append((str(i), entry))
    return out


def cmd_judge(a) -> int:
    battery = load_battery(a.battery)
    if a.example:
        cases = ROOT / "fixtures/jev" / battery["battery"] / "cases.jsonl"
        first = (
            next((json.loads(ln) for ln in cases.read_text().splitlines() if ln.strip()), None)
            if cases.is_file()
            else None
        )
        example = [{"id": "example-1", "item": first["item"] if first else "..."}]
        emit(
            {
                "battery": battery["battery"],
                "item_key": battery["item_key"],
                "questions": list(battery["questions"]),
                "items": example,
            },
            a.json,
            f"items for {battery['battery']}: a JSON array; each item is sent as state.{battery['item_key']}\n"
            + json.dumps(example, indent=2),
        )
        return EXIT_OK
    key = os.environ.get("TYPESAFE_API_KEY", "")
    if not key:
        msg = "TYPESAFE_API_KEY is not set; Jev was not used. Fall back to the deterministic checks."
        emit({"used": False, "reason": msg}, a.json, f"jev not used: {msg}", ok=False, errors=[msg])
        return EXIT_NO_KEY
    if err := jev_url_error():
        raise usage_error(err)
    trace = Path(a.trace) if a.trace else None
    if a.eval:
        return judge_eval(battery, key, a, trace)
    if not a.items:
        raise usage_error("no items given; pass an items file (or - for stdin), or --eval")
    try:
        raw = json.loads(sys.stdin.read() if a.items == "-" else Path(a.items).read_text())
    except (OSError, ValueError) as e:
        raise usage_error(f"cannot read items: {e}; pass a JSON array file or - for stdin") from e
    results = judge_items(battery, normalize_items(raw), key, trace)
    lines = [
        f"battery {battery['battery']} ({battery['model']}, {battery['rule']} {battery['threshold']})",
        f"flag means: {battery['flag_means']}",
        f"clear means: {battery['clear_means']}",
        "unsettled counts as flag.",
    ]
    for r in results:
        ans = " ".join(f"{q}={p}" for q, p in r["answers"].items())
        lines.append(f"  {r['outcome']:<9} {r['id']}  {ans}" + (f"  error: {r['error']}" if r["error"] else ""))
    call_errors = [f"{r['id']}: {r['error']}" for r in results if r["error"]]
    emit(
        {"used": True, "battery": battery["battery"], "model": battery["model"], "results": results},
        a.json,
        "\n".join(lines),
        ok=not call_errors,
        errors=call_errors,
    )
    return EXIT_CALLS if call_errors else EXIT_OK


def judge_eval(battery: dict, key: str, a, trace: Path | None) -> int:
    cases_path = Path(a.cases) if a.cases else ROOT / "fixtures/jev" / battery["battery"] / "cases.jsonl"
    try:
        cases = [json.loads(ln) for ln in cases_path.read_text().splitlines() if ln.strip()]
        if any(not isinstance(c, dict) or not {"id", "item", "expected"} <= set(c) for c in cases):
            raise ValueError("every case needs id, item, and expected")
    except (OSError, ValueError) as e:
        raise usage_error(f"cannot read cases: {e}; pass --cases with a cases.jsonl file") from e
    if a.split != "all":
        cases = [c for c in cases if c.get("split") == a.split]
    if not cases:
        return fail(a, f"no cases selected from {cases_path} (split {a.split}); nothing was checked", EXIT_FAIL)
    results = {r["id"]: r for r in judge_items(battery, [(c["id"], c["item"]) for c in cases], key, trace)}
    report: dict[str, dict] = {}
    for c in cases:
        r = results[c["id"]]
        got = "flag" if r["outcome"] in ("flag", "unsettled") else "clear"
        bucket = report.setdefault(c.get("split", "tune"), {"n": 0, "fn": [], "fp": [], "unsettled": [], "errors": 0})
        bucket["n"] += 1
        bucket["errors"] += bool(r["error"])
        if r["outcome"] == "unsettled":
            bucket["unsettled"].append(c["id"])
        if c["expected"] == "flag" and got == "clear":
            bucket["fn"].append({"id": c["id"], "answers": r["answers"], "note": c.get("note", "")})
        elif c["expected"] == "clear" and got == "flag":
            bucket["fp"].append({"id": c["id"], "answers": r["answers"], "note": c.get("note", "")})
    lines = [f"eval {battery['battery']} ({battery['model']}, {battery['rule']} {battery['threshold']})"]
    for split, b in sorted(report.items()):
        lines.append(
            f"  {split}: n={b['n']} false-negatives={len(b['fn'])} false-positives={len(b['fp'])} "
            f"unsettled={len(b['unsettled'])} call-errors={b['errors']}"
        )
        for kind in ("fn", "fp"):
            for x in b[kind]:
                lines.append(f"    {kind} {x['id']} {x['answers']}")
    call_errors = any(b["errors"] for b in report.values())
    failed = bool(report.get("holdout", {}).get("fn")) or call_errors
    emit(
        {"battery": battery["battery"], "report": report, "pass": not failed},
        a.json,
        "\n".join(lines),
        ok=not failed,
        errors=["eval failed: a holdout false negative or a call error"] if failed else None,
    )
    return EXIT_CALLS if call_errors else EXIT_FAIL if failed else EXIT_OK


